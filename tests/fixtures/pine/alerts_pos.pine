//@version=6
indicator("alert positives")
cross = ta.crossover(close, ta.sma(close, 20))
if cross
    alert("crossed")  // expect: alert-unconfirmed
    alert("crossed", alert.freq_once_per_bar)  // expect: alert-unconfirmed
alertcondition(cross, "Cross", "crossed")  // expect: alertcondition-unconfirmed
